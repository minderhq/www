---
import Layout from '../layouts/Layout.astro';

const DOCS_URL = 'https://minderhq.github.io/docs/';
const SELF_HOSTING_URL = 'https://minderhq.github.io/docs/self-hosting/';
const CONTACT_URL = 'https://github.com/minderhq/www/issues/new';

const pillars = [
  {
    title: 'Local inference',
    body: 'Ollama-backed LLMs with no cloud API keys and no data leaving your box by default. Switch between local, external, and automatic failover — or connect an optional remote provider (OpenAI-compatible, Anthropic, …) per organization when you want one.',
  },
  {
    title: 'Knowledge — RAG and graph',
    body: 'Retrieval that goes beyond naive vector search: hybrid, parent-child, corrective and RAPTOR hierarchical retrieval, plus a knowledge-graph path over the same documents.',
  },
  {
    title: 'Extensible, safely',
    body: 'Plugins are manifest-based, fixed handlers — never uploaded, arbitrary code. New tools register for LLM function-calling without trusting a stranger’s script.',
  },
  {
    title: 'One control-plane UI',
    body: 'Knowledge bases, pipelines, the graph explorer, plugins, models, and health — one coherent surface, not a pile of raw service forms.',
  },
  {
    title: 'Observability built in',
    body: 'Prometheus, Grafana, Jaeger, and OpenTelemetry wired in from the start, with self-healing status checks instead of silent failures.',
  },
  {
    title: 'Runs on modest hardware',
    body: 'ARM and Raspberry Pi are first-class targets. One command provisions the whole stack and fills in secrets for you.',
  },
];
---

<Layout
  title="Minder — Your private AI platform"
  description="Local inference, your own data, and an extensible tool ecosystem — installs on modest hardware with a single command."
>
  <header class="wrap hero">
    <p class="eyebrow">Minder</p>
    <h1>Your private AI platform.</h1>
    <p class="lede">
      Local inference, your own data, and an extensible tool ecosystem — that installs
      on hardware you own, down to a Raspberry Pi, with a single command.
    </p>
    <div class="cta-row">
      <a class="btn btn-primary" href={SELF_HOSTING_URL}>Get started self-hosting</a>
      <a class="btn btn-ghost" href={DOCS_URL}>Read the docs</a>
    </div>
  </header>

  <main id="main-content" class="wrap">
    <section class="pillars">
      {
        pillars.map((p) => (
          <article class="card">
            <h3>{p.title}</h3>
            <p>{p.body}</p>
          </article>
        ))
      }
    </section>

    <section class="split">
      <h2>Run it your way</h2>
      <div class="split-grid">
        <div class="card">
          <h3>Self-host</h3>
          <p>
            Run the full platform on hardware you own. <code>bash setup.sh</code>
            provisions everything and self-heals. A free tier lets you evaluate it
            end to end; a license unlocks the full product.
          </p>
          <a href={SELF_HOSTING_URL}>Self-hosting guide →</a>
        </div>
        <div class="card">
          <h3>Hosted (in development)</h3>
          <p>
            A managed, multi-tenant hosted tier — team and enterprise licensing — is
            under active development. Pricing and the free-tier boundary aren't
            finalized yet.
          </p>
          <a href={CONTACT_URL}>Get in touch →</a>
        </div>
      </div>
    </section>

    <section class="ecosystem">
      <h2>Open ecosystem, licensed core</h2>
      <p>
        The core platform is a licensed product; the parts you build <em>against</em>
        are open source on GitHub under
        <a href="https://github.com/minderhq">minderhq</a>. Start from the template
        and you have a working plugin in minutes — plugins are declarative and run
        no uploaded code.
      </p>
      <div class="repo-grid">
        <a class="repo" href="https://github.com/minderhq/plugin-sdk"><b>plugin-sdk</b><span>Authoring contract &amp; SDK</span></a>
        <a class="repo" href="https://github.com/minderhq/plugin-template"><b>plugin-template</b><span>Scaffold a new plugin</span></a>
        <a class="repo" href="https://github.com/minderhq/plugins"><b>plugins</b><span>First-party &amp; community catalog</span></a>
        <a class="repo" href="https://github.com/minderhq/client"><b>client</b><span>The management console UI</span></a>
        <a class="repo" href="https://github.com/minderhq/cli"><b>cli</b><span>Command-line client</span></a>
        <a class="repo" href="https://minderhq.github.io/docs/plugins/"><b>docs</b><span>Plugin authoring guide</span></a>
      </div>
    </section>

    <section class="faq">
      <h2>Questions, answered</h2>
      <div class="faq-grid">
        <div class="qa">
          <h3>Is my data private?</h3>
          <p>Yes — Minder is local-first. Inference runs on your own hardware via
          Ollama, host ports are loopback-bound, and nothing leaves the box by
          default. External access is reverse-proxy and SSO gated.</p>
        </div>
        <div class="qa">
          <h3>What hardware do I need?</h3>
          <p>It runs in Docker on x86-64 and ARM — Raspberry Pi 4 is a first-class,
          verified target. One command provisions the whole stack.</p>
        </div>
        <div class="qa">
          <h3>Is it open source?</h3>
          <p>The <em>ecosystem</em> is (Apache-2.0): the plugin SDK, template,
          catalog, web client, and CLI. The core platform is a licensed commercial
          product — open where you build, funded where it counts.</p>
        </div>
        <div class="qa">
          <h3>Can I extend it safely?</h3>
          <p>Plugins are manifest-based, fixed handlers — never uploaded, arbitrary
          code. New tools register for LLM function-calling without you trusting a
          stranger's script.</p>
        </div>
        <div class="qa">
          <h3>How do I get the platform?</h3>
          <p>A free tier lets you evaluate it end to end; a license unlocks the full
          product. A managed hosted tier is in development —
          <a href={CONTACT_URL}>get in touch</a>.</p>
        </div>
        <div class="qa">
          <h3>Where do I start?</h3>
          <p>Read the <a href={DOCS_URL}>docs</a>, follow the
          <a href={SELF_HOSTING_URL}>self-hosting guide</a>, or build a plugin from
          the <a href="https://github.com/minderhq/plugin-template">template</a>.</p>
        </div>
      </div>
    </section>
  </main>

  <footer class="wrap footer">
    <p>
      <a href="https://github.com/minderhq">GitHub</a> ·
      <a href={DOCS_URL}>Docs</a> ·
      <a href={CONTACT_URL}>Contact</a>
    </p>
  </footer>
</Layout>

<style>
  .hero {
    padding: 6rem 1.5rem 3rem;
    text-align: center;
  }

  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 0.8rem;
    color: var(--text-dim);
    margin: 0 0 1rem;
  }

  h1 {
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    margin: 0 0 1.25rem;
    line-height: 1.1;
  }

  .lede {
    max-width: 640px;
    margin: 0 auto 2rem;
    color: var(--text-dim);
    font-size: 1.15rem;
  }

  .cta-row {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 600;
  }

  .btn-primary {
    background: var(--accent);
    color: var(--btn-primary-text);
  }

  .btn-ghost {
    border: 1px solid var(--border);
    color: var(--text);
  }

  main {
    padding-bottom: 4rem;
  }

  h2 {
    font-size: 1.75rem;
    margin: 4rem 0 1.5rem;
  }

  .pillars {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.25rem;
    margin-top: 3rem;
  }

  .card {
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 1.5rem;
  }

  .card h3 {
    margin-top: 0;
  }

  .card p {
    color: var(--text-dim);
    margin-bottom: 0.75rem;
  }

  .split-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.25rem;
  }

  .ecosystem p {
    color: var(--text-dim);
    max-width: 720px;
  }

  .repo-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .repo {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 0.9rem 1.1rem;
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: 10px;
    text-decoration: none;
    color: var(--text);
    transition: border-color 0.15s ease;
  }

  .repo:hover {
    border-color: var(--accent);
  }

  .repo span {
    color: var(--text-dim);
    font-size: 0.9rem;
  }

  .faq-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.25rem;
    margin-top: 3rem;
  }

  .qa h3 {
    margin: 0 0 0.4rem;
    font-size: 1.1rem;
  }

  .qa p {
    color: var(--text-dim);
    margin: 0;
  }

  .footer {
    padding: 2rem 1.5rem 3rem;
    border-top: 1px solid var(--border);
    color: var(--text-dim);
    text-align: center;
  }
</style>
